kind: InitConfiguration
apiVersion: kubeadm.k8s.io/v1beta4
---
kind: ClusterConfiguration
apiVersion: kubeadm.k8s.io/v1beta4
{% if repo_mirror is defined %}
imageRepository: {{ repo_mirror }}/registry.k8s.io
{% endif %}
kubernetesVersion: {{ k8s_version }}
clusterName: {{ clustername | default('kubernetes') }}
controlPlaneEndpoint: {{ control_plane|trim }}
networking:
  podSubnet: {{ k8s_cidr | default('10.85.0.0/16')}}
  serviceSubnet: {{ k8s_svc_cidr | default('10.96.0.0/12')}}
apiServer:
  certSANs:
{% for name in groups.master %}
  - {{ name }}
  - {{ hostvars[name].ansible_host }}
{% endfor %}
  - {{ ansible_facts['fqdn']| regex_replace('^([\\d\\w]+)-[\\d\\w]+\\.', '\\1.') }}
{% if api_loadbalancer is defined %}
  - {{ api_loadbalancer }}
{% endif %}
{% if oidc.issuer_url is defined %}
  extraArgs: 
    oidc-issuer-url: {{ oidc.issuer_url }}
    oidc-client-id: {{ oidc.client_id }}
    oidc-username-claim: {{ oidc.username.claim | default("preferred_username", true) }}
    oidc-username-prefix: {{  "'" + oidc.username.prefix + "'"  | default("'oidc:'", true) }}
    oidc-groups-prefix: {{  "'" + oidc.groups.prefix + "'"  | default("'oidc:'", true) }}
    oidc-groups-claim: {{ oidc.groups.claim | default("groups", true) }}
{% endif %}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
resolvConf: /etc/resolv.conf.kubernetes
systemReserved:
  cpu: "{{ kubelet_system_reserved_cpu | default('500m') }}"
  memory: "{{ kubelet_system_reserved_memory | default('1Gi') }}"
  ephemeral-storage: "{{ kubelet_system_reserved_ephemeral_storage | default('2Gi') }}"
kubeReserved:
  cpu: "{{ kubelet_kube_reserved_cpu | default('1') }}"
  memory: "{{ kubelet_kube_reserved_memory | default('1500Mi') }}"
  ephemeral-storage: "{{ kubelet_kube_reserved_ephemeral_storage | default('2Gi') }}"
# evict pods before the node runs out of memory/disk, so the kubelet gets to choose
# the victim gracefully instead of the kernel OOM killer decide
evictionHard:
  memory.available: "{{ kubelet_eviction_hard_memory_available | default('500Mi') }}"
  nodefs.available: "10%"
  imagefs.available: "10%"
  nodefs.inodesFree: "5%"
  imagefs.inodesFree: "5%"
evictionSoft:
  memory.available: "{{ kubelet_eviction_soft_memory_available | default('1Gi') }}"
  nodefs.available: "15%"
  imagefs.available: "15%"
evictionSoftGracePeriod:
  memory.available: "2m"
  nodefs.available: "2m"
  imagefs.available: "2m"